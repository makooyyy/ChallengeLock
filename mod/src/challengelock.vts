(function () {
    var context = $.GetContextPanel(), hud = context;
    while (hud.GetParent()) hud = hud.GetParent();
    var gameplay, open = false, heartbeat = 0;
    function update() {
        if (!context.IsValid()) return;
        if (!gameplay || !gameplay.IsValid()) gameplay = hud.FindChildTraverse('gameplay_hud');
        var visible = !!(gameplay && gameplay.BHasClass('gShopOpen'));
        var now = Date.now();
        if (visible !== open || (visible && now - heartbeat >= 2000)) {
            open = visible;
            heartbeat = now;
            $.Msg('[ChallengeLock] companion=' + (open ? 'open' : 'closed'));
        }
        $.Schedule(0.2, update);
    }
    update();
})();
