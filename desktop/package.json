{
  "name": "challengelock-desktop",
  "version": "1.28.0",
  "description": "Desktop app for ChallengeLock (Deadlock Challenge Roulette)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "node doctor.js",
    "prebuild": "node copy-web.js",
    "build": "electron-builder --win nsis && node scripts/generate-latest-yml.js",
    "generate:latest": "node scripts/generate-latest-yml.js"
  },
  "author": "makooyyy",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.makooyyy.challengelock",
    "productName": "ChallengeLock",
    "artifactName": "ChallengeLock-${version}.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "game.js",
      "log-watch.js",
      "overlay.html",
      "web/**/*",
      "match-monitor.js",
      "mod-bridge.js",
      "mod-shop.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChallengeLock"
    },
    "publish": {
      "provider": "github",
      "owner": "makooyyy",
      "repo": "ChallengeLock",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@45.4.1": true
  }
}
