{
  "name": "challengelock",
  "private": true,
  "type": "module",
  "description": "Random hero, challenge and build generator for Deadlock. Static site, no build step.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "check:sw": "node scripts/check-sw.mjs",
    "check:catalog": "node scripts/sync-catalog.mjs --check",
    "check": "npm run check:sw && npm run lint && npm run format:check && npm test",
    "lint": "eslint .",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
